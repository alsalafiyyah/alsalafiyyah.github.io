{
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  },
  "scripts": {
    "build:css": "npx @tailwindcss/cli -i ./src/input.css -o ./assets/css/main.css",
    "watch:css": "npx @tailwindcss/cli -i ./src/input.css -o ./assets/css/main.css --watch",
    "start": "npm run build:css && (npm run watch:css & bundle exec jekyll serve --host 0.0.0.0)"
  }
}