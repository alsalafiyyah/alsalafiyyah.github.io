---
layout: null
sitemap:
  exclude: 'yes'
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% assign default_date = site.time | date_to_xmlschema %}
  {% assign published_posts = site.posts | where_exp: "item", "item.published != false" %}
  {% for post in published_posts %}
    {% assign p_site = post.sitemap %}
    <url>
      <loc>{{ site.url }}{{ post.url }}</loc>
      <lastmod>{% if p_site.lastmod %}{{ p_site.lastmod | date: "%Y-%m-%d" }}{% elsif post.date %}{{ post.date | date_to_xmlschema }}{% else %}{{ default_date }}{% endif %}</lastmod>
      <changefreq>{{ p_site.changefreq | default: "monthly" }}</changefreq>
      <priority>{{ p_site.priority | default: "0.5" }}</priority>
    </url>
  {% endfor %}
  {% assign eligible_pages = site.pages | where_exp: "item", "item.sitemap.exclude != 'yes' and item.name != 'feed.xml'" %}
  {% for page in eligible_pages %}
    {% assign p_site = page.sitemap %}
    <url>
      <loc>{{ site.url }}{{ page.url | remove: "index.html" }}</loc>
      <lastmod>{% if p_site.lastmod %}{{ p_site.lastmod | date: "%Y-%m-%d" }}{% elsif page.date %}{{ page.date | date_to_xmlschema }}{% else %}{{ default_date }}{% endif %}</lastmod>
      <changefreq>{{ p_site.changefreq | default: "monthly" }}</changefreq>
      <priority>{{ p_site.priority | default: "0.3" }}</priority>
    </url>
  {% endfor %}
</urlset>