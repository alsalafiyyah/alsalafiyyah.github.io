---
layout: null
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" {% if site.lang %}xml:lang="{{ site.lang }}"{% endif %}>
    <generator uri="https://jekyllrb.com/" version="{{ jekyll.version }}">Jekyll</generator>
    <link href="{{ site.url }}/feed.xml" rel="self" type="application/atom+xml" />
    <link href="{{ site.url }}" rel="alternate" type="text/html" {% if site.lang %}hreflang="{{ site.lang }}" {% endif %}/>
    <updated>{{ site.time | date_to_xmlschema }}</updated>
    <id>{{ site.url | xml_escape }}</id>

    <title type="html">{{ site.title | default: site.name | smartify | xml_escape }}</title>

    {% if site.description %}
        <subtitle>{{ site.description | xml_escape }}</subtitle>
    {% endif %}

    {% if site.author %}
        {% assign default_author_name = site.author.name | default: site.author %}
        <author>
            <name>{{ default_author_name | xml_escape }}</name>
            {% if site.author.email %}<email>{{ site.author.email | xml_escape }}</email>{% endif %}
            {% if site.author.uri %}<uri>{{ site.author.uri | xml_escape }}</uri>{% endif %}
        </author>
    {% endif %}

    {% assign posts = site.posts | where_exp: "post", "post.draft != true" %}
    {% for post in posts limit:50 %}
        {% assign post_title = post.title | smartify | strip_html | normalize_whitespace | xml_escape %}
        {% assign post_url = site.url | append: post.url %}
        {% assign post_date = post.date | date_to_xmlschema %}
        <entry{% if post.lang %}{{" "}}xml:lang="{{ post.lang }}"{% endif %}>
            <title type="html">{{ post_title }}</title>
            <link href="{{ post_url }}" rel="alternate" type="text/html" title="{{ post.title | xml_escape }}" />
            <published>{{ post_date }}</published>
            <updated>{{ post.last_modified_at | date_to_xmlschema | default: post_date }}</updated>
            <id>{{ post_url | xml_escape }}</id>
            <content type="html" xml:base="{{ post_url | xml_escape }}">{{ post.content | strip | xml_escape }}</content>

            {% for author_id in post.authors %}
              {% assign author_obj = site.data.authors[author_id] | default: site.author %}
              {% assign author_name = author_obj.fullname | default: author_obj.name | default: author_id %}
              <author>
                  <name>{{ author_name | xml_escape }}</name>
                  {% if author_obj.email %}<email>{{ author_obj.email | xml_escape }}</email>{% endif %}
                  {% if author_obj.uri %}<uri>{{ author_obj.uri | xml_escape }}</uri>{% endif %}
              </author>
            {% endfor %}

            {% if post.category %}
                <category term="{{ post.category | xml_escape }}" />
            {% endif %}

            {% for tag in post.tags %}
                <category term="{{ tag | xml_escape }}" />
            {% endfor %}

            {% if post.summary != blank %}
                <summary type="html">{{ post.summary | markdownify | strip_html | normalize_whitespace | xml_escape }}</summary>
            {% endif %}

            {% assign img_path = post.path | replace: '_posts', 'posts' | replace: '.html', '' | replace: '.md', '' %}
            <media:thumbnail xmlns:media="http://search.yahoo.com/mrss/" url="{{ site.url }}/img/{{ img_path }}.jpg" />
        </entry>
    {% endfor %}
</feed>