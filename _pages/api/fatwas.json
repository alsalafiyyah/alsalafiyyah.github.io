---
layout: null
permalink: /api/fatwas.json
---
[
  {% for post in site.posts %}
  {
    "publisher": {{ post.publisher | jsonify }},
    "title": {{ post.title | default: "" | jsonify }},
    "hijri_date": {{ post.hijri | jsonify }},
    "date": "{{ post.date | date_to_xmlschema }}",
    "url": {{ post.url | absolute_url | jsonify }},
    "audio": {{ post.mp3 | jsonify }},
    "link": {{ post.link | jsonify }},
    "categories": {{ post.category | default: post.categories | jsonify }},
    "tags": {{ post.tags | jsonify }},
    "article_taken_from": {{ post.article_taken_from | jsonify }},
    "translated_by": {{ post.translated_by | jsonify }},
    "lang": {{ post.lang | jsonify }},
    "base_url": {{ site.url | default: "https://alsalafiyyah.github.io" | jsonify }},
    "shaykhs": {{ post.shaykhs | jsonify }},
    "muftis": {{ post.muftis | jsonify }},
    "summary": {{ post.summary | default: "" | jsonify }},
    "content": {{ post.content | strip_html | strip_newlines | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]