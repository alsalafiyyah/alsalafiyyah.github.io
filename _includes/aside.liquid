<aside itemscope itemtype="https://schema.org/WPSideBar" class="hidden md:block md:col-span-3 space-y-6 sticky top-12 self-start">

    <!-- Latest Posts Section -->
    <div class="border-t-2 border-black dark:border-white pt-4">
        <span class="text-[10px] font-black uppercase tracking-widest text-gray-400 block mb-5">{{ site.site_elements.latest_posts }}</span>
        <ul class="space-y-6">
            {% for post in site.posts limit:3 %}
            <li>
              <a href="{{ post.url | relative_url }}" class="group block">
                    <span class="text-[10px] font-bold opacity-50 block mb-1">
                       {{ post.hijri }} \ {{ post.date | date: "%Y-%m-%d" }}
                    </span>
                     <span class="text-lg font-bold group-hover:underline">{{ post.title }}</span>
              </a>
            </li>
            {% endfor %}
        </ul>
    </div>

    <!-- Categories Section -->
    {% if site.categories_select == true %}
    <div class="border-t-2 border-black dark:border-white pt-4">
        <span class="text-[10px] font-black uppercase tracking-widest text-gray-400 block mb-2">{{ site.site_elements.categories }}</span>
        <div class="relative group">
            <select dir="{{ site.site_elements.dir }}" 
                onchange="window.location.href=this.value" 
                class="w-full bg-transparent border-2 border-black dark:border-white px-4 py-3 text-[10px] font-black uppercase tracking-widest appearance-none cursor-pointer focus:bg-black focus:text-white dark:focus:bg-white dark:focus:text-black transition-all outline-none"
            >
                <option value="" disabled selected>{{ site.site_elements.select_category }}</option>
                {% for cat in site.categories %}
                    <option value="{{ cat.url | relative_url }}">
                        {{ cat.title | default: cat.category }}
                    </option>
                {% endfor %}
            </select>
            
            <div dir="{{ site.site_elements.dir }}" class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M19 9l-7 7-7-7" />
                </svg>
            </div>
        </div>
    </div>
    {% endif %}

</aside>