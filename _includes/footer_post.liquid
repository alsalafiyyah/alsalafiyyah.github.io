{% if page.date %}
<footer class="mt-24 border-t-4 footer-post border-black dark:border-white pt-12 space-y-12 transition-colors">
    
    <!-- Committee / Scholars -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 border-b border-gray-100 dark:border-zinc-800 pb-12 transition-colors">

    {% if page.muftis %}
        {% if page.muftis.chairman or page.muftis.deputy_chairman or page.muftis.members %}
            {% if page.muftis.chairman %}
            <div class="space-y-4">
                <h5 class="text-[10px] font-black uppercase tracking-widest text-gray-400">Chairman</h5>
                <div class="flex flex-col gap-2">
                    {% for person in page.muftis.chairman %}
                    <a href="{{ person.url | relative_url }}" class="text-lg font-black italic serif hover:line-through">{{ person.name }}</a>
                    {% endfor %}
                </div>
            </div>
            {% endif %}

            {% if page.muftis.deputy_chairman %}
            <div class="space-y-4">
                <h5 class="text-[10px] font-black uppercase tracking-widest text-gray-400">Deputy</h5>
                <div class="flex flex-col gap-2">
                    {% for person in page.muftis.deputy_chairman %}
                    <a href="{{ person.url | relative_url }}" class="text-lg font-black italic serif hover:line-through">{{ person.name }}</a>
                    {% endfor %}
                </div>
            </div>
            {% endif %}

            {% if page.muftis.members %}
            <div class="space-y-4">
                <h5 class="text-[10px] font-black uppercase tracking-widest text-gray-400">Members</h5>
                <div class="flex flex-col gap-2">
                    {% for person in page.muftis.members %}
                    <a href="{{ person.url | relative_url }}" class="text-lg font-black italic serif hover:line-through">{{ person.name }}</a>
                    {% endfor %}
                </div>
            </div>
            {% endif %}

        {% elsif page.muftis.shaykh %}
            <div class="md:col-span-3 space-y-4">
                <h5 class="text-[10px] font-black uppercase tracking-widest text-gray-400">{{ site.site_elements.scholars }}</h5>
                <div class="flex flex-wrap gap-x-8 gap-y-2">
                    {% for person in page.muftis.shaykh %}
                    <a href="{{ person.url | relative_url }}" class="text-lg font-black italic serif hover:line-through">{{ person.name }}</a>
                    {% endfor %}
                </div>
            </div>
        {% endif %}

    {% elsif page.shaykhs %}
        <div class="md:col-span-3 space-y-4">
            <h5 class="text-[10px] font-black uppercase tracking-widest text-gray-400">{{ site.site_elements.scholars }}</h5>
            <p class="text-lg font-black italic serif">
                {% for sh in page.shaykhs %}
                    <span>{{ sh }}</span>{% unless forloop.last %}, {% endunless %}
                {% endfor %}
            </p>
        </div>
    {% elsif page.scholar %}
        <div class="md:col-span-3 space-y-4">
            <h5 class="text-[10px] font-black uppercase tracking-widest text-gray-400">{{ site.site_elements.scholars }}</h5>
            <p class="text-lg font-black italic serif">
                {{ page.scholar }}
            </p>
        </div>
    {% elsif page.mufti %}
        <div class="md:col-span-3 space-y-4">
            <h5 class="text-[10px] font-black uppercase tracking-widest text-gray-400">{{ site.site_elements.scholars }}</h5>
            <p class="text-lg font-black italic serif">
                {{ page.mufti }}
            </p>
        </div>
    {% else %}
        {% assign groups = "group1,group2,group3,group4,group5,group6,group7,group8,group9,group10,group11,group12,group13" | split: "," %}
        {% for group_name in groups %}
            {% if page[group_name] %}
                {% assign group_data = site[group_name] %}
                
                {% if group_data.chairman %}
                <div class="space-y-4">
                    <h5 class="text-[10px] font-black uppercase tracking-widest text-gray-400">Chairman</h5>
                    <div class="flex flex-col gap-2">
                        {% for chairman in group_data.chairman %}
                        <a href="{{ chairman.url | relative_url }}" class="text-lg font-black italic serif hover:line-through">{{ chairman.name }}</a>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}

                {% if group_data.deputy_chairman %}
                <div class="space-y-4">
                    <h5 class="text-[10px] font-black uppercase tracking-widest text-gray-400">Deputy</h5>
                    <div class="flex flex-col gap-2">
                        {% for deputy in group_data.deputy_chairman %}
                        <a href="{{ deputy.url | relative_url }}" class="text-lg font-black italic serif hover:line-through">{{ deputy.name }}</a>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}

                {% if group_data.members %}
                <div class="space-y-4">
                    <h5 class="text-[10px] font-black uppercase tracking-widest text-gray-400">Members</h5>
                    <div class="flex flex-col gap-2">
                        {% for member in group_data.members %}
                        <a href="{{ member.url | relative_url }}" class="text-lg font-black italic serif hover:line-through">{{ member.name }}</a>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}
                {% break %}
            {% endif %}
        {% endfor %}
    {% endif %}

    </div>
    
    <!-- Metadata Grid: Source, Categories, Translation, Sharing -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 text-[10px] font-black uppercase tracking-widest">
        
        <!-- Left Column -->
        <div class="space-y-6">
            <div>
                <span class="text-gray-400 block mb-1">{{ site.site_elements.published }}</span>
                    <p class="leading-relaxed">{{ page.hijri }} \ {{ page.date | date: "%Y-%m-%d" }}</p>
            </div>

            {% if page.categories.size > 0 %}
            <div>
                <span class="text-gray-400 block mb-2">{{ site.site_elements.classified_under }}</span>
                <div class="flex flex-wrap gap-2">
                    {% for category in page.categories %}
                    <a href="{{ '/category' | relative_url }}/{{ category | slugify }}" class="border border-black dark:border-white px-2 py-1 hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black transition-all">
                        {{ category }}
                    </a>
                    {% endfor %}
                </div>
            </div>
            {% endif %}

            {% if page.source %}
            <div>
                <span class="text-gray-400 block mb-1">{{ site.site_elements.source }}</span>
                <p class="leading-relaxed">{{ page.source }}</p>
            </div>
            {% endif %}

            {% if page.article_taken_from %}
            <div>
                <span class="text-gray-400 block mb-1">{{ site.site_elements.taken_from }}</span>
                {% for t in page.article_taken_from.taken_from %}
                <a href="{{ t.web_url }}" rel="nofollow" target="_blank" class="border-b border-black dark:border-white hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black transition-all">
                    {{ t.web_title }}
                </a>
                {% endfor %}
            </div>
            {% endif %}
        </div>

        <!-- Right Column -->
        <div class="space-y-6 md:text-right">
            {% if page.translated_by %}
            <div>
                <span class="text-gray-400 block mb-1">{{ site.site_elements.translator }}</span>
                <p>{{ page.translated_by }}</p>
            </div>
            {% endif %}

            {% if page.translation == true %}
            <div>
                <span class="text-gray-400 block mb-2">{{ site.site_elements.translate }}</span>
                {% if page.lang == 'ar' %}
                 <a href="https://alsalafiyyah.github.io{{ page.url | remove_first: '/ar' }}" class="border border-black dark:border-white px-2 py-1 hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black transition-all">
                   {{ site.site_elements.translation }}
                 </a>
                {% else %}
                  <a href="https://alsalafiyyah.github.io/ar{{ page.url }}" class="border border-black dark:border-white px-2 py-1 hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black transition-all">
                   {{ site.site_elements.translation }}
                  </a>
                {% endif %}
            </div>
            {% endif %}

            <!-- Last Modified -->
            <div>
                <span class="text-gray-400 block mb-1">{{ site.site_elements.last_modified }}</span>
                <p class="tabular-nums">
                    <b><span id='last-modified'></span></b>
                </p>
            </div>

            <!-- Error report -->
            <div>
                <span class="text-gray-400 block mb-1">{{ site.site_elements.error_report }}</span>
                <div class="tabular-nums">
                    <button id="openReportModal" type="button" class="inline-flex items-center gap-2 text-xs font-black uppercase tracking-wider text-red-600 dark:text-red-400 hover:underline focus:outline-none">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                        </svg>
                        {{ site.site_elements.error_report }}
                    </button>
                </div>
            </div>

            <div>
                <span class="text-gray-400 block mb-4">{{ site.site_elements.share }}</span>
                <div class="flex flex-wrap md:justify-end gap-x-6 gap-y-2" dir="{{ site.site_elements.dir }}">

                    <a aria-label="Share on X Twitter" rel="noopener noreferrer" href="https://x.com/intent/tweet?text={{ page.title | url_encode }}&url={{ site.url }}{{ page.url }}" target="_blank" class="group inline-flex items-center">
                        <svg class="w-6 h-6 fill-current text-zinc-800 dark:text-white transition-colors duration-200 group-hover:text-red-500 dark:group-hover:text-red-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512"><title>Share on X Twitter</title><!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.--><path d="M357.2 48L427.8 48 273.6 224.2 455 464 313 464 201.7 318.6 74.5 464 3.8 464 168.7 275.5-5.2 48 140.4 48 240.9 180.9 357.2 48zM332.4 421.8l39.1 0-252.4-333.8-42 0 255.3 333.8z"/></svg>
                    </a>

                    <a aria-label="Share on Bluesky" rel="noopener noreferrer" href="https://bsky.app/intent/compose?text={{ page.title | url_encode }}%20{{ site.url | url_encode }}{{ page.url | url_encode }}" target="_blank" class="group inline-flex items-center">
                        <svg class="w-6 h-6 fill-current text-zinc-800 dark:text-white transition-colors duration-200 group-hover:text-red-500 dark:group-hover:text-red-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 576 512">
                           <title>Share on Bluesky</title>
                           <!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
                           <path d="M407.8 294.7c-3.3-.4-6.7-.8-10-1.3 3.4 .4 6.7 .9 10 1.3zM288 227.1C261.9 176.4 190.9 81.9 124.9 35.3 61.6-9.4 37.5-1.7 21.6 5.5 3.3 13.8 0 41.9 0 58.4S9.1 194 15 213.9c19.5 65.7 89.1 87.9 153.2 80.7 3.3-.5 6.6-.9 10-1.4-3.3 .5-6.6 1-10 1.4-93.9 14-177.3 48.2-67.9 169.9 120.3 124.6 164.8-26.7 187.7-103.4 22.9 76.7 49.2 222.5 185.6 103.4 102.4-103.4 28.1-156-65.8-169.9-3.3-.4-6.7-.8-10-1.3 3.4 .4 6.7 .9 10 1.3 64.1 7.1 133.6-15.1 153.2-80.7 5.9-19.9 15-138.9 15-155.5s-3.3-44.7-21.6-52.9c-15.8-7.1-40-14.9-103.2 29.8-66.1 46.6-137.1 141.1-163.2 191.8z"/>
                        </svg>
                    </a>
                    
                    <a aria-label="Share on Threads" rel="noopener noreferrer" href="https://www.threads.net/intent/post?text={{ page.title | url_encode }}%20{{ site.url }}{{ page.url }}" target="_blank" class="group inline-flex items-center">
                        <svg class="w-6 h-6 fill-current text-zinc-800 dark:text-white transition-colors duration-200 group-hover:text-red-500 dark:group-hover:text-red-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512"><title>Share on Threads</title><!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.--><path d="M340.8 238c-.6-69.6-38.3-111.5-102-111.5-42.5 0-78.3 19.2-97.1 49.9l41.2 28.7c10.7-16.8 25.4-30.8 52.4-30.8 30.5 0 46.3 17 50.8 48.5-14.7-2.3-29.5-3.5-44.6-3.5-82.4 0-121.1 37.3-121.1 86.6s38.8 79.7 95.9 79.7c62.7 0 100.1-42.2 115.4-94.5 15.9 7.2 26.9 24 26.9 49.3 0 67.6-78 104.5-144.1 104.5-97.5 0-161.3-64-161.3-168.2 0-127.6 84.3-209.4 197.6-209.4 76 0 113.6 33.4 139.2 78.1L432 115.9c-27.8-58-89.9-99.5-183.1-99.5-148.5 0-249.5 105.4-249.5 258.2 0 139.8 98.9 220.9 216.7 220.9 97.4 0 195.8-56.8 195.8-154 0-50.8-29.2-84.5-71.2-103.5zM214.4 334.9c-21.5 0-40.4-10.2-40.4-29 0-29.6 36.4-38.6 72-38.6 13.5 0 26.8 .9 38.5 3.5-8.4 38.5-33.4 64.2-70 64.2l0 0z"/></svg>
                    </a>
                    
                    <a aria-label="Share on VK" rel="noopener noreferrer" href="https://vk.com/share.php?url={{ site.url }}{{ page.url }}&title={{ page.title }}&description={{ page.summary }}&image={{ page.img }}" target="_blank" class="group inline-flex items-center">
                        <svg class="w-6 h-6 fill-current text-zinc-800 dark:text-white transition-colors duration-200 group-hover:text-red-500 dark:group-hover:text-red-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512"><title>Share on VK</title><!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.--><path d="M31.5 63.5C0 95 0 145.7 0 247L0 265C0 366.3 0 417 31.5 448.5S113.7 480 215 480l17.9 0c101.4 0 152.1 0 183.5-31.5S448 366.3 448 265l0-17.9c0-101.4 0-152.1-31.5-183.5S334.3 32 233 32L215 32C113.7 32 63 32 31.5 63.5zM75.6 168.3l51.1 0c1.7 85.5 39.4 121.7 69.3 129.2l0-129.2 48.2 0 0 73.7c29.5-3.2 60.5-36.8 70.9-73.7l48.2 0c-3.9 19.2-11.8 37.3-23.1 53.3s-25.7 29.5-42.5 39.6c18.7 9.3 35.2 22.4 48.4 38.5s22.9 34.9 28.3 55l-53 0c-4.9-17.5-14.8-33.1-28.6-45s-30.7-19.4-48.7-21.6l0 66.6-5.8 0c-102.1 0-160.3-70-162.8-186.5z"/></svg>
                    </a>
                    
                    <a aria-label="Share on Telegram" rel="noopener noreferrer" href="https://t.me/share/url?url={{ site.url }}{{ page.url }}&text={{ page.title | url_encode }}" target="_blank" class="group inline-flex items-center">
                        <svg class="w-6 h-6 fill-current text-zinc-800 dark:text-white transition-colors duration-200 group-hover:text-red-500 dark:group-hover:text-red-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><title>Share on Telegram</title><!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.--><path d="M256 8a248 248 0 1 0 0 496 248 248 0 1 0 0-496zM371 176.7c-3.7 39.2-19.9 134.4-28.1 178.3-3.5 18.6-10.3 24.8-16.9 25.4-14.4 1.3-25.3-9.5-39.3-18.7-21.8-14.3-34.2-23.2-55.3-37.2-24.5-16.1-8.6-25 5.3-39.5 3.7-3.8 67.1-61.5 68.3-66.7 .2-.7 .3-3.1-1.2-4.4s-3.6-.8-5.1-.5c-2.2 .5-37.1 23.5-104.6 69.1-9.9 6.8-18.9 10.1-26.9 9.9-8.9-.2-25.9-5-38.6-9.1-15.5-5-27.9-7.7-26.8-16.3 .6-4.5 6.7-9 18.4-13.7 72.3-31.5 120.5-52.3 144.6-62.3 68.9-28.6 83.2-33.6 92.5-33.8 2.1 0 6.6 .5 9.6 2.9 2 1.7 3.2 4.1 3.5 6.7 .5 3.2 .6 6.5 .4 9.8z"/></svg>
                    </a>
                    
                    <a aria-label="Share on WhatsApp" rel="noopener noreferrer" href="https://wa.me/?text={{ page.title | url_encode }}%20{{ site.url }}{{ page.url }}" target="_blank" class="group inline-flex items-center">
                        <svg class="w-6 h-6 fill-current text-zinc-800 dark:text-white transition-colors duration-200 group-hover:text-red-500 dark:group-hover:text-red-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512"><title>Share on WhatsApp</title><!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.--><path d="M380.9 97.1c-41.9-42-97.7-65.1-157-65.1-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480 117.7 449.1c32.4 17.7 68.9 27 106.1 27l.1 0c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3 18.6-68.1-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1s56.2 81.2 56.1 130.5c0 101.8-84.9 184.6-186.6 184.6zM325.1 300.5c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8s-14.3 18-17.6 21.8c-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7 .9-6.9-.5-9.7s-12.5-30.1-17.1-41.2c-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2s-9.7 1.4-14.8 6.9c-5.1 5.6-19.4 19-19.4 46.3s19.9 53.7 22.6 57.4c2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4s4.6-24.1 3.2-26.4c-1.3-2.5-5-3.9-10.5-6.6z"/></svg>
                    </a>
                    
                    <a aria-label="Share on Facebook" rel="noopener noreferrer" href="https://www.facebook.com/sharer/sharer.php?u={{ site.url }}{{ page.url }}" target="_blank" class="group inline-flex items-center">
                        <svg class="w-6 h-6 fill-current text-zinc-800 dark:text-white transition-colors duration-200 group-hover:text-red-500 dark:group-hover:text-red-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512"><title>Facebook</title><!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.--><path d="M64 32C28.7 32 0 60.7 0 96L0 416c0 35.3 28.7 64 64 64l98.2 0 0-145.8-52.8 0 0-78.2 52.8 0 0-33.7c0-87.1 39.4-127.5 125-127.5 16.2 0 44.2 3.2 55.7 6.4l0 70.8c-6-.6-16.5-1-29.6-1-42 0-58.2 15.9-58.2 57.2l0 27.8 83.6 0-14.4 78.2-69.3 0 0 145.8 129 0c35.3 0 64-28.7 64-64l0-320c0-35.3-28.7-64-64-64L64 32z"/></svg>
                    </a>
                    
                    <a aria-label="Share on Tumblr" rel="noopener noreferrer" href="http://www.tumblr.com/share/link?url={{ page.url | absolute_url | url_encode }}&name={{ page.title | url_encode }}&description={{ page.summary | strip_html | truncate: 160 | url_encode }}" target="_blank" class="group inline-flex items-center">
                        <svg class="w-6 h-6 fill-current text-zinc-800 dark:text-white transition-colors duration-200 group-hover:text-red-500 dark:group-hover:text-red-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><title>Share on Tumblr</title><!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.--><path d="M309.9 480.3c-13.6 14.5-50 31.7-97.4 31.7-120.8 0-147-88.8-147-140.6l0-144-47.5 0c-5.5 0-10-4.5-10-10l0-68c0-7.2 4.5-13.6 11.3-16 62-21.8 81.5-76 84.3-117.1 .8-11 6.5-16.3 16.1-16.3l70.9 0c5.5 0 10 4.5 10 10l0 115.2 83 0c5.5 0 10 4.4 10 9.9l0 81.7c0 5.5-4.5 10-10 10l-83.4 0 0 133.2c0 34.2 23.7 53.6 68 35.8 4.8-1.9 9-3.2 12.7-2.2 3.5 .9 5.8 3.4 7.4 7.9l22 64.3c1.8 5 3.3 10.6-.4 14.5z"/></svg>
