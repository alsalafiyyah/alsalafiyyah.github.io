<script type="application/ld+json">
[
  {
    "@context": "https://schema.org",
    "@type": "{% if page.date %}BlogPosting{% else %}WebPage{% endif %}",
    "headline": {{ page.title | default: site.title | jsonify }},
    "description": {{ page.summary | default: site.description | strip_html | jsonify }},
    "url": {{ page.url | absolute_url | jsonify }},
    {% if page.date %}"datePublished": "{{ page.date | date_to_xmlschema }}",{% endif %}
    "publisher": {
      "@type": "Organization",
      "name": "{{ site.title }}",
      "logo": {
        "@type": "ImageObject",
        "url": "{{ '/assets/logos/logo.svg' | absolute_url }}"
      }
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "{{ site.url }}{{ site.baseurl }}/"
      }
      {% if page.url != "/" %}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": {{ page.title | jsonify }},
        "item": {{ page.url | absolute_url | jsonify }}
      }
      {% endif %}
    ]
  }
{% if page.url == "/" or page.url == "index.html" %}
,{
  "@type": "WebSite",
  "@id": "{{ site.url | append: '/#website' }}",
  "url": "{{ site.url }}{{ site.baseurl }}/",
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "{{ site.url }}{{ site.baseurl }}/search/?q={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
}
{% endif %}
  {% if page.mp3 %}
  ,{
    "@context": "https://schema.org",
    "@type": "AudioObject",
    "name": {{ page.title | default: site.title | jsonify }},
    "description": {{ page.summary | default: site.description | strip_html | jsonify }},
    "contentUrl": {{ page.url | absolute_url | jsonify }},
    {% if page.date %}"uploadDate": "{{ page.date | date_to_xmlschema }}",{% endif %}
    "encodingFormat": "audio/mpeg"
  }
  {% endif %}
  {% if page.videoID %}
  ,{
    "@context": "https://schema.org",
    "@type": "VideoObject",
    "name": {{ page.title | default: site.title | jsonify }},
    "description": {{ page.summary | default: site.description | strip_html | jsonify }},
    "thumbnailUrl": "https://img.youtube.com/vi/{{ page.videoID }}/maxresdefault.jpg",
    {% if page.date %}"uploadDate": "{{ page.date | date_to_xmlschema }}",{% endif %}
    "embedUrl": "https://www.youtube.com/embed/{{ page.videoID }}?modestbranding=1&rel=0",
    "author": {
      "@type": "Person",
      "name": "{{ site.title }}"
    }
  }
  {% endif %}
  ,{
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Navigation Menu",
    "itemListElement": [
      {% for item in site.menu_navigation %}
      {
        "@type": "ListItem",
        "position": {{ forloop.index }},
        "name": "{{ item.title }}",
        "url": "{{ item.url | absolute_url }}"
      }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  }
]
</script>