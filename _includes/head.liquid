<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="generator" content="Jekyll v{{ jekyll.version }}" />
<title>{{ page.title | default: site.title | escape }}</title>
<meta name="description" content="{{ page.summary | default: site.description | strip_html | normalize_whitespace | truncate: 160 | escape }}"/>
<link rel="canonical" href="{{ page.url | replace:'/index.html','/' | absolute_url }}" />
<meta name="robots" content="index, follow">
<meta name="mobile-web-app-capable" content="yes">

<meta property="og:site_name" content="{{ site.title | escape }}" />
<meta property="og:title" content="{{ page.title | default: site.title | escape }}" />
<meta property="og:description" content="{{ page.summary | default: site.description | strip_html | normalize_whitespace | truncate: 160 | escape }}"/>
<meta property="og:image" content="{{ '/assets/images/fb.jpg' | absolute_url }}" />
<meta property="og:type" content="{% if page.date %}article{% else %}website{% endif %}" />
<meta property="og:url" content="{{ page.url | replace:'/index.html','/' | absolute_url }}" />

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ page.title | default: site.title | escape }}">
<meta name="twitter:description" content="{{ page.summary | default: site.description | strip_html | normalize_whitespace | truncate: 160 | escape }}"/>
<meta name="twitter:image" content="{{ '/assets/images/fb.jpg' | absolute_url }}"/>

<meta name="theme-color" content="#ffffff"> 
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<link rel="manifest" href="{{ '/manifest.json' | absolute_url }}">
<link rel="apple-touch-icon" sizes="180x180" href="{{ '/assets/icons/apple-touch-icon.png' | absolute_url }}">
<link rel="icon" type="image/x-icon" href="{{ '/assets/icons/favicon.ico' | absolute_url }}"/>

{% if site.webmaster_verifications %}
<meta name="p:domain_verify" content="{{ site.webmaster_verifications.domain_verify }}"/>
<meta name="google-site-verification" content="K7QDv3cEwylAu_9fndO3ebQmNowxxRYCpqDEzQKQOy4" />
<meta name="yandex-verification" content="{{ site.webmaster_verifications.yandex }}" />
<meta name="msvalidate.01" content="{{ site.webmaster_verifications.bing }}" />
<meta name="google-adsense-account" content="{{ site.webmaster_verifications.google-ads }}">
<meta name="norton-safeweb-site-verification" content="{{ site.webmaster_verifications.norton-safeweb }}" />
<meta name="wot-verification" content="{{ site.webmaster_verifications.wot-verification }}"/>
{% endif %}

{% if page.date %}
<meta property="article:published_time" content="{{ page.date | date_to_xmlschema }}">
{% endif %}

{% if paginator.previous_page %}
<link rel="prev" href="{{ paginator.previous_page_path | absolute_url }}" />
{% endif %}
{% if paginator.next_page %}
<link rel="next" href="{{ paginator.next_page_path | absolute_url }}" />
{% endif %}

<link rel="alternate" type="application/rss+xml" title="{{ site.title }}" href="{{ '/feed.xml' | absolute_url }}">

<!-- 1. Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preconnect" href="https://img.youtube.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&family=Playfair+Display:ital,wght@0,900;1,900&display=swap" rel="stylesheet">

<!-- 2. FontAwesome  -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" media="print" onload="this.media='all'"/>
<noscript><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/></noscript>

<!-- 3. Frameworks & Scripts -->
<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
<script type="module" src="https://cdn.jsdelivr.net/npm/player.style/tailwind-audio/+esm"></script>
<script src="https://cdn.tailwindcss.com"></script>

<!-- 4. Custom Styles -->
<style>
        body { font-family: 'Inter', sans-serif; }
        .serif { font-family: 'Playfair Display', serif; }
        /* Custom scrollbar */
        ::-webkit-scrollbar { width: 5px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: black; }
        .dark ::-webkit-scrollbar-thumb { background: white; }

        /* --- Jekyll Markdown Custom Styles --- */
        h3, h4, h5, h6 {
            font-family: 'Inter', sans-serif;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: -0.05em;
            line-height: 0.9;
            margin-top: 2.5rem;
            margin-bottom: 1.5rem;
        }

        h1 { font-size: 4rem; text-transform: none; font-family: 'Playfair Display', serif; }
        h2 { font-size: 3rem; padding-bottom: 0.5rem; font-weight: 900; }
        
        #question, #answer, .post h3, .post h2, .post h4, .page h3 {
            font-family: 'Inter', sans-serif;
            font-size: 1.25rem;
            line-height: 1.8;
            margin-bottom: 1.5rem;
            font-weight: bold;
        }

        hr { border: none; border-top: 0px solid black; margin: 4rem 0; }
        
        article ol { list-style-type: decimal !important; padding-bottom: 24px;list-style-position: inside;font-size: 1.125rem;line-height: 1.75;}
        article ul { list-style-type: circle !important;padding-bottom: 24px;list-style-position: inside;font-size: 1.125rem;line-height: 1.75;}
        article p {
            margin-bottom: 1.5rem;
            font-size: 1.125rem;
            line-height: 1.75;
        }
        .post a {
            color: #ef4444 !important;
            text-decoration: none;
        }
        .post a:hover {
            color: #ef4444 !important;
            text-decoration: underline;
        }
/* The Footnote Container */
.footnotes {
    margin-top: 2rem;
    padding-top: 2rem;
}
.footnote a {
    margin-left: 3px;
    color: #ef4444 !important;
}
.footnotes ol li p {
    font-size: 14px !important;
    line-height: 1.4 !important;
    color: #666 !important;
    margin: 0 !important; 
    display: inline;
}

.footnotes ol li {
    font-size: 14px !important;
    color: #999;
    margin-bottom: 0.5rem;
}

.reversefootnote {
    font-size: 14px !important;
    text-decoration: none !important;
    margin-left: 5px;
    color: #ef4444 !important;
}

.reversefootnote:hover {
    background: none !important; 
    text-decoration: underline !important;
}
</style>

