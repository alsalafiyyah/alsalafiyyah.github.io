<footer itemscope itemtype="https://schema.org/WPFooter" class="border-t-4 border-black bg-white text-black dark:border-white dark:bg-zinc-950 dark:text-white py-12 px-8 max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-start gap-12 text-[10px] font-black uppercase tracking-[0.2em] transition-colors duration-300">
    
    <div itemscope itemtype="https://schema.org/Organization" class="flex flex-col gap-4 max-w-sm w-full">
        <div class="flex items-center justify-between md:justify-start gap-4">
            <!-- Logo Container -->
            <a href="{{ '/' | relative_url }}" class="flex-none">
                <img 
                    src="{{ '/assets/logos/logo.svg' | relative_url }}" 
                    alt="{{ site.title }} Logo" 
                    class="w-8 h-8 object-contain dark:invert transition-all duration-300"
                    width="32" 
                    height="32"
                >
            </a>

            <button id="theme-toggle" type="button" class="text-black dark:text-white hover:opacity-50 transition-opacity focus:outline-none border-2 border-current p-1.5 hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black" aria-label="Toggle Theme">
                <svg id="theme-toggle-dark-icon" class="hidden w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
                </svg>
                <svg id="theme-toggle-light-icon" class="hidden w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"></path>
                </svg>
            </button>

        <a href="/ar/" class="text-black dark:text-white hover:opacity-50 transition-opacity">
    <svg class="w-8 h-8" fill="currentColor" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" zoomAndPan="magnify" viewBox="0 0 283.5 283.500005" height="378" preserveAspectRatio="xMidYMid meet" version="1.0">
        <defs>
            <clipPath id="a0737a88c8">
                <path d="M 0.21875 1.027344 L 263.039062 1.027344 L 263.039062 263.847656 L 0.21875 263.847656 Z M 0.21875 1.027344 " clip-rule="nonzero"/>
            </clipPath>
            <clipPath id="cb365dba77">
                <rect x="0" width="264" y="0" height="265"/>
            </clipPath>
        </defs>
        <g transform="matrix(1, 0, 0, 1, 10, 6)">
            <g clip-path="url(#cb365dba77)">
                <g clip-path="url(#a0737a88c8)">
                    <!-- Changed fill="#000000" to fill="currentColor" -->
                    <path fill="currentColor" d="M 0.21875 1.027344 L 0.21875 198.140625 L 65.925781 198.140625 L 65.925781 263.847656 L 263.039062 263.847656 L 263.039062 66.730469 L 197.335938 66.730469 L 197.335938 1.027344 Z M 22.121094 22.929688 L 175.433594 22.929688 L 175.433594 73.148438 L 120.402344 128.179688 L 90.671875 44.832031 L 73.6875 44.832031 L 44.023438 128.992188 L 44.023438 143.386719 L 65.925781 143.386719 L 65.925781 132.734375 L 66.03125 132.4375 L 98.671875 132.4375 L 98.777344 132.757812 L 98.777344 143.386719 L 105.195312 143.386719 L 72.34375 176.238281 L 22.121094 176.238281 Z M 82.246094 86.429688 L 90.84375 110.535156 L 73.753906 110.535156 Z M 190.917969 88.632812 L 241.136719 88.632812 L 241.136719 241.945312 L 87.828125 241.945312 L 87.828125 191.726562 Z M 176.71875 121.484375 C 164.769531 121.484375 152.441406 133.347656 152.441406 143.773438 C 152.441406 155.347656 161.894531 164.261719 161.894531 164.261719 C 161.894531 164.261719 142.582031 173.558594 142.582031 192.132812 C 142.582031 210.746094 164.148438 220.042969 181.121094 220.042969 C 206.671875 220.042969 219.238281 207.746094 219.238281 207.746094 C 219.238281 207.746094 176.117188 209.839844 166.128906 188.878906 C 164.082031 184.554688 166.371094 171.851562 176.117188 167.511719 C 189.6875 161.457031 199.261719 170.785156 199.261719 170.785156 L 205.613281 147.859375 C 205.613281 147.859375 195.582031 150.402344 185.957031 150.402344 C 182.5625 150.402344 170.726562 148.246094 170.726562 140.757812 C 170.726562 134.777344 178.398438 132.394531 181.101562 132.394531 C 190.792969 132.394531 199.902344 135.964844 199.902344 135.964844 L 199.902344 127.152344 C 199.902344 127.152344 191.773438 121.484375 176.71875 121.484375 Z M 176.71875 121.484375 "/>
                </g>
            </g>
        </g>
    </svg>
</a>

        </div>

        <div class="flex flex-col mt-2">
            <p>
                &copy; {{ "now" | date: "%Y" }} 
                <span itemprop="name">{{ site.title }}</span>
                <meta itemprop="url" content="{{ site.url }}">
                <link itemprop="logo" href="{{ '/assets/logos/logo.svg' | relative_url }}">
            </p>
            <span class="text-zinc-600 text-[8px] tracking-[0.4em] mt-1">{{ site.site_elements.footer_slogan }}</span>
        </div>
    </div>

    <div class="flex flex-col sm:flex-row gap-12 md:gap-16 w-full md:w-auto">
        
        <!-- Column 2: External Link List -->
        <div class="flex flex-col gap-3 min-w-[120px]">

        </div>

        <!-- Column 3: Site Internal Navigation -->
        <div class="flex flex-col gap-3 min-w-[140px]">
            <span class="text-gray-400 dark:text-zinc-600 text-[9px] tracking-[0.3em]">{{ site.site_elements.navigation }}</span>
            <div class="flex flex-col gap-2 items-start">
                {% for item in site.footer_navigation %}
                    <a itemprop="sameAs" href="{{ item.url | relative_url }}" class="hover:line-through transition-all">
                        {{ item.title }}
                    </a>
                {% endfor %}
            </div>
        </div>

    </div>
</footer>