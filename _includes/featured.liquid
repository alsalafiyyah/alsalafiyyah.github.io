<!-- Top Section: Hero Block -->
<section class="mb-16 pb-12 border-b-2 border-black/10 dark:border-white/10 mt-10">
    <div class="flex flex-col space-y-8">
        <div class="flex items-center gap-4 text-[10px] font-black uppercase tracking-[0.3em] text-gray-400 italic">
            <span class="text-red-500">•</span>
            <span class="text-black dark:text-white">Featured Selected Fatwa</span>
        </div>
        {% assign featured_post = site.posts | where: "featured", true | first %}
        {% if featured_post %}
        <h2 class="text-6xl md:text-[5vw] lg:text-[4.5vw] font-black uppercase tracking-tighter leading-[0.85] serif">
            <a href="{{ featured_post.url | relative_url }}" class="hover:line-through transition-all">
               {{ featured_post.title }}
            </a>
        </h2>
        <div class="flex items-center gap-6 text-[10px] font-black uppercase tracking-widest opacity-50">
            <span>1441-03-22 / 19.11.2019</span>
        </div>
        <p class="text-xl md:text-3xl font-bold leading-relaxed opacity-85 max-w-5xl">
                  {% if featured_post.summary %}
                    {{ featured_post.summary | strip_html }}
                  {% endif %}
        </p>
        <div>
            <a href="{{ featured_post.url | relative_url }}" class="inline-block bg-black text-white dark:bg-white dark:text-black px-12 py-5 font-black uppercase tracking-widest text-xs hover:scale-105 transition-transform">
                Read Full Fatwa →
            </a>
        </div>
       {% endif %}
    </div>
</section>

<section class="mb-6 pb-12 mt-12">

    <!-- Main 3-Column Grid Container -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 items-start">
        <div class="col-span-1 flex flex-col space-y-6 lg:col-span-1">
            <div class="border-2 border-black dark:border-white bg-white dark:bg-black overflow-hidden transition-colors duration-300">
                <!-- Vertical Image Preview with Modal Trigger -->
                <div class="relative group cursor-pointer w-full bg-gray-50 dark:bg-zinc-900 border-b-2 border-black dark:border-white" id="open-modal-btn">
                    <img src="https://alsalafiyyah.github.io/assets/images/img.webp" alt="Circulated Image of Imam Muhammad bin Abd al-Wahhab" class="w-full h-auto block object-cover">
                    <!-- Zoom Hint Overlay -->
                    <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center text-white text-xs uppercase font-black tracking-widest pointer-events-none">
                        Click to View Full Image
                    </div>
                </div>

                <!-- Vertical Card Content -->
                <div class="flex flex-col space-y-4 p-6">
                    <div class="flex items-center gap-6 text-[10px] font-black uppercase tracking-widest opacity-50">
                        <span>1448-03-07 / 20.08.2026</span>
                    </div>
                    <h3 class="text-2xl font-black uppercase tracking-tighter leading-[0.95] serif">
                        The Truth Behind the Circulated Image of Imam Muhammad bin Abd al-Wahhab
                    </h3>
                    
                    <!-- Collapsible Text Container -->
                    <div class="relative">
                        <!-- Short Initial Preview Text -->
                        <div id="text-preview" class="space-y-3">
                            <p class="text-sm font-medium leading-relaxed opacity-80">
                                The text in the provided image translates as follows:
                            </p>
                            <p class="text-xs font-normal leading-relaxed opacity-60">
                                <strong>On the right side (False Claim):</strong> An alleged picture of the renewer Imam Muhammad ibn Abd al-Wahhab...
                            </p>
                        </div>

                        <!-- Full Text (Initially Hidden) -->
                        <div id="text-full" class="hidden space-y-3 mt-2">
                            <p class="text-sm font-medium leading-relaxed opacity-80">
                                The text in the provided image translates as follows:
                            </p>
                            <p class="text-xs font-normal leading-relaxed opacity-60">
                                <strong>On the right side (False Claim):</strong> An alleged picture of the renewer Imam Muhammad ibn Abd al-Wahhab, may Allah have mercy on him, is being circulated across social media platforms. The image shows a person sitting on a chair, who they claim is Imam Muhammad ibn Saud, may Allah have mercy on him, and another standing beside him, who they claim is Imam Muhammad ibn Abd al-Wahhab, may Allah have mercy on him.
                            </p>
                            <p class="text-xs font-normal leading-relaxed opacity-60">
                                <strong>On the left side (The Truth):</strong> This information is incorrect. The person sitting on the chair is Sheikh Abdullah bin Isa bin Ali Al Khalifa, a son of the ruler of Bahrain, and not Imam Muhammad ibn Saud... It is worth noting that the first photograph was taken in 1826, and the invention of photography was announced on August 19, 1839.
                            </p>
                            <p class="text-xs font-normal leading-relaxed opacity-60">
                                Source: <a href="https://mujaddid.net/%d8%b5%d9%88%d8%b1%d8%a9-%d8%a7%d9%84%d8%a5%d9%85%d8%a7%d9%85-%d8%a7%d9%84%d9%85%d8%ac%d8%af%d8%af-%d9%85%d8%ad%d9%85%d8%af%d8%a8%d9%86-%d8%b9%d8%a8%d8%af%d8%a7%d9%84%d9%88%d9%87%d8%a7%d8%a8-%d8%a7/" target="_blank" class="underline font-bold hover:text-red-500">صورة الإمام محمد بن عبدالوهاب الفوتوغرافية بين الكذب والحقيقة؟!</a>
                            </p>
                        </div>
                    </div>

                    <!-- Show More / Show Less Button -->
                    <div class="pt-2">
                        <button id="toggle-text-btn" class="text-xs font-black uppercase tracking-widest text-black dark:text-white border-b-2 border-black dark:border-white pb-1 hover:text-red-500 hover:border-red-500 transition-colors">
                            Show More ↓
                        </button>
                    </div>
                </div>
            </div>
        </div>

<!-- Column 2 -->
<div class="col-span-1 flex flex-col space-y-6 lg:col-span-1">
    
    <!-- Top Part: Featured Muqolat Card with Background Image -->
    {% assign featured_muqolat_post = site.posts | where: "featured_muqolat", true | first %}
    <div class="relative bg-cover bg-no-repeat bg-center flex flex-col justify-end min-h-[450px] overflow-hidden" style="background-image:url('{{ featured_muqolat_post.img | relative_url }}')">
        <!-- Top Badge -->
        <span class="text-xs font-sans font-bold text-white absolute left-6 top-6 pb-2.5 border-b-2 border-red-500 z-10">Muqolat</span>
        
        {% if featured_muqolat_post %}
        <!-- Gradient Overlay & Content -->
        <div class="flex flex-col items-start justify-end text-left pt-32 px-8 pb-8 bg-gradient-to-t from-black/90 via-black/40 to-transparent w-full">
            <h3 class="flex items-center font-sans font-bold text-xs text-white mb-3">
                <span class="w-2 h-2 rounded-full bg-red-500 flex-shrink-0 mr-2.5"></span>
                {{ featured_muqolat_post.hijri }} / {{ featured_muqolat_post.date | date: "%d.%m.%Y" }}
            </h3>
            <a href="{{ featured_muqolat_post.url | relative_url }}" class="text-white text-2xl font-bold hover:underline leading-snug">
                {{ featured_muqolat_post.title }}
            </a>
        </div>
        {% endif %}
    </div>

    <!-- Bottom Part: Standard Muqolat List (No Images) & Button -->
    <div class="flex flex-col space-y-4 pt-2">
        {% assign muqolat = site.posts | where_exp: "post", "post.active == 'muqolat'" %}
        {% for post in muqolat limit:2 %}
            {% if post.url != featured_muqolat_post.url %}
                <div class="py-1">
                    <span class="text-[10px] font-bold opacity-50 block mb-1">{{ post.hijri }} / {{ post.date | date: "%d.%m.%Y" }}</span>
                    <a href="{{ post.url | relative_url }}" class="text-lg font-bold group-hover:underline block hover:underline">
                        {{ post.title }}
                    </a>
                </div>
            {% endif %}
        {% endfor %}

            <div class="flex flex-col w-full">
                <div class="w-full flex h-0.5 bg-yellow-700 bg-opacity-10">
                    <div class="w-1/2 bg-red-500 h-full"></div>
                </div>
                <a href="{{ '/muqolat' | relative_url }}" class="font-sans text-xs uppercase font-bold pt-5 flex w-full">View All Muqolat
                    <svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 ml-auto text-red-500">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                </a>
            </div>
    </div>
</div>

        <!-- Column 3: Tabbed Content (Recent, Audio, Video Fatwas) -->
        <div class="flex flex-col justify-between h-full space-y-6 lg:col-span-1 border-t-2 lg:border-t-0 lg:border-l-2 border-black/10 dark:border-white/10 lg:pl-12 pt-8 lg:pt-0" id="fatwa-tabs-container">
            <div>
                <!-- Tab Navigation Headers -->
                <div class="flex items-center gap-4 mb-6 border-b-2 border-yellow-700 border-opacity-10 space-x-6 dark:border-white/10 pb-3 text-xs font-black uppercase tracking-wider overflow-x-auto">
                    <button type="button" data-tab="recent" class="tab-btn text-black dark:text-white border-b-2 border-red-500 dark:border-white pb-1 transition-colors whitespace-nowrap">
                        Recent
                    </button>
                    <button type="button" data-tab="audio" class="tab-btn text-gray-400 hover:text-black dark:hover:text-white pb-1 transition-colors whitespace-nowrap">
                        Audios
                    </button>
                    <button type="button" data-tab="video" class="tab-btn text-gray-400 hover:text-black dark:hover:text-white pb-1 transition-colors whitespace-nowrap">
                        Videos
                    </button>
                </div>

                <!-- Tab Content Panels -->
                <div class="tab-contents">
                    <!-- Recent Fatwas Panel -->
                    <div id="panel-recent" class="tab-panel space-y-6">
    <div class="md:col-span-3 col-span-12 space-y-6 py-6 flex flex-col">
    {% for post in site.posts limit:5 %}
     {% if post.url == featured_post.url %}{% continue %}{% endif %}
      <div class="flex flex-col">
        <h3 class="flex items-center font-sans font-bold text-xs text-gray-600 text-opacity-40 mb-3.5">
          <span class="w-2 h-2 rounded-full bg-red-500 flex-shrink-0 mr-2.5"></span>
          {{ post.hijri }} / {{ post.date | date: "%d.%m.%Y" }}
        </h3>
        <a href="{{ post.url | relative_url }}" class="font-medium hover:underline">{{ post.title }}</a>
      </div>
     {% endfor %}
    </div>
                    </div>

                    <!-- Audio Fatwas Panel -->
                    <div id="panel-audio" class="tab-panel space-y-6 hidden">
                            <div class="md:col-span-3 col-span-12 space-y-6 py-6 flex flex-col">
                           {% assign audio_posts = site.posts | where_exp: "post", "post.active == 'audios'" %}
                           {% for post in audio_posts limit:5 %}
      <div class="flex flex-col">
        <h3 class="flex items-center font-sans font-bold text-xs text-gray-600 text-opacity-40 mb-3.5">
          <span class="w-2 h-2 rounded-full bg-red-500 flex-shrink-0 mr-2.5"></span>
          {{ post.hijri }} / {{ post.date | date: "%d.%m.%Y" }}
        </h3>
        <a href="{{ post.url | relative_url }}" class="font-medium hover:underline">{{ post.title }}</a>
      </div>
                           {% endfor %}
                        </div>
                    </div>

                    <!-- Video Fatwas Panel -->
                    <div id="panel-video" class="tab-panel space-y-6 hidden">
                        <div class="flex flex-col space-y-6">
                           {% assign video_posts = site.posts | where_exp: "post", "post.active == 'videos'" %}
                           {% for post in video_posts limit:5 %}
                            <div class="flex items-start">
                              <img src="https://img.youtube.com/vi/{{ post.videoID }}/maxresdefault.jpg" alt="{{ post.title }}" class="w-20 h-20 flex-shrink-0 mr-4 object-cover" />
                              <div class="flex-grow min-w-0 flex flex-col">
                                <a href="{{ post.url | relative_url }}" class="mb-0.5 hover:underline block font-bold">{{ post.title }}</a>
                                <p class="text-gray-600 text-opacity-40 text-xs mt-auto font-sans">{{ post.hijri }} / {{ post.date | date: "%d.%m.%Y" }}</p>
                              </div>
                            </div>
                           {% endfor %}
                        </div>
                    </div>

                </div>
            </div>

            <div class="flex flex-col w-full">
                <div class="w-full flex h-0.5 bg-yellow-700 bg-opacity-10">
                    <div class="w-1/2 bg-red-500 h-full"></div>
                </div>
                <a href="{{ '/fatwas' | relative_url }}" class="font-sans text-xs uppercase font-bold pt-5 flex w-full">View All Fatwas
                    <svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 ml-auto text-red-500">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                </a>
            </div>

        </div>

    </div>
</section>

