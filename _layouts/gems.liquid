---
layout: general
---

<div class="prose prose-lg dark:prose-invert">
<h2>{{ page.title }}</h2>
{% if page.img %}
<img src="{{ page.img }}" alt="{{ page.title}}" class="max-w-full h-auto"/>
{% endif %}
{{ content }}
{% if page.source %}
<p class="text-sm">Source: <b>{{ page.source }}</b></p>
{% endif %}
{% if page.ar_text %}
<div class="mt-8 text-xl" dir="rtl">
 {{ page.ar_text }}
</div>
{% endif %}
</div>
