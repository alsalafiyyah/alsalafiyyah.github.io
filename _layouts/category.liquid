---
layout: default
---

<div class="category-feed">
  <h1>{{ page.title }}</h1>

  {% assign posts_list = paginator.posts | default: page.pager.posts %}

  {% if posts_list and posts_list.size > 0 %}
    <ul class="posts-list">
      {% for post in posts_list %}
        <li class="post-item">
          <h2><a href="{{ post.url }}">{{ post.title }}</a></h2>
          <span class="post-date">{{ post.date | date: "%B %d, %Y" }}</span>
          <p>{{ post.excerpt }}</p>
        </li>
      {% endfor %}
    </ul>

    <!-- Pagination Links -->
    {% assign pager_obj = paginator | default: page.pager %}
    {% if pager_obj.total_pages > 1 %}
      <nav class="pagination-nav">
        {% if pager_obj.previous_page %}
          <a href="{{ pager_obj.previous_page_path }}">&larr; Newer Fatwas</a>
        {% endif %}

        <span>Page {{ pager_obj.page }} of {{ pager_obj.total_pages }}</span>

        {% if pager_obj.next_page %}
          <a href="{{ pager_obj.next_page_path }}">Older Fatwas &rarr;</a>
        {% endif %}
      </nav>
    {% endif %}

  {% else %}
    <p>No posts available under this section.</p>
  {% endif %}
</div>