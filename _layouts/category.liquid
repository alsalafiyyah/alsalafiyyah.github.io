---
layout: default
title: "Audio Fatwas"
active: audios
paginate: 5 # Optional: override default per-page limit for this page
---

<div class="category-feed">
  <h1>{{ page.title }}</h1>

  {% if page.pager.posts %}
    <ul class="posts-list">
      {% for post in page.pager.posts %}
        <li class="post-item">
          <h3><a href="{{ post.url }}">{{ post.title }}</a></h3>
          <span class="post-date">{{ post.date | date: "%B %d, %Y" }}</span>
          <p>{{ post.excerpt }}</p>
        </li>
      {% endfor %}
    </ul>

    <!-- Pagination Navigation -->
    <nav class="pagination-nav">
      {% if page.pager.previous_page %}
        <a href="{{ page.pager.previous_page_path }}" class="prev-link">&larr; Newer Posts</a>
      {% endif %}

      <span class="page-info">
        Page {{ page.pager.current_page }} of {{ page.pager.total_pages }}
      </span>

      {% if page.pager.next_page %}
        <a href="{{ page.pager.next_page_path }}" class="next-link">Older Posts &rarr;</a>
      {% endif %}
    </nav>
  {% else %}
    <p>No posts available under this section.</p>
  {% endif %}
</div>