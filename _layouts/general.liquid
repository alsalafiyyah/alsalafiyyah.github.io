{% include head.liquid %}
<body dir="{{ site.site_elements.dir }}" itemscope itemtype="https://schema.org/WebPage" 
            class="bg-white dark:bg-zinc-950 dark:text-zinc-100 text-black antialiased selection:bg-black selection:text-white dark:selection:bg-white dark:selection:text-black transition-colors duration-300 is-preload" onload="setModifiedDate(); setAccessedDate();">
  {% include_cached navbar.liquid %}
  
  <main role="main" class="max-w-7xl mx-auto px-8">
      
    <section class="grid grid-cols-1 md:grid-cols-12 gap-12 py-24 items-start">
        {% include_cached aside.liquid %}
        <article class="md:col-span-8 md:col-start-5 max-w-none">
            {{ content }}
        </article>
    </section>
  </main>
  
  {% include bug-report-modal.liquid %}
  {% include_cached footer.liquid %}
  {% include scripts.html defer=true %}  
</body>
</html>