---
layout: null
---
{% capture navbar %}
  {% include_cached navbar.liquid %}
{% endcapture %}
{% capture footer_content %}
  {% include_cached footer.liquid %}
{% endcapture %}
<!DOCTYPE html>
<html lang="{{ site.site_elements.lang }}" dir="{{ site.site_elements.dir }}">
<head>
{% include head.liquid %}
</head>
<body dir="{{ site.site_elements.dir }}" itemscope itemtype="https://schema.org/WebPage" class="bg-white dark:bg-zinc-950 dark:text-zinc-100 text-black antialiased selection:bg-black selection:text-white dark:selection:bg-white dark:selection:text-black transition-colors duration-300 is-preload">

{{ navbar }}

<main role="main" class="max-w-7xl mx-auto px-8">

<!-- Top Section: Hero Block -->
<section class="mb-16 pb-12 border-b-2 border-black/10 dark:border-white/10 mt-10">
    {% include_cached hero.liquid %}
</section>
<!-- /Top Section: Hero Block -->

<!-- Main 3-Column Grid Container -->
<section class="mb-6 pb-12 mt-12">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 items-start">

        <!-- Column 1 -->
        <div class="col-span-1 flex flex-col space-y-6 lg:col-span-1">
           {% include_cached homepage_col1.liquid %}
        </div>

        <!-- Column 2: Muqolat -->
        <div class="col-span-1 flex flex-col space-y-6 lg:col-span-1">
           {% include_cached homepage_col2.liquid %}
        </div>

        <!-- Column 3: Tabbed Content -->
        <div class="flex flex-col justify-between h-full space-y-6 lg:col-span-1 border-t-2 lg:border-t-0 lg:border-l-2 border-black/10 dark:border-white/10 lg:pl-12 pt-8 lg:pt-0" id="fatwa-tabs-container">
            {% include_cached homepage_col3.liquid %}
        </div>

    </div>
</section>
<!-- /Main 3-Column Grid Container -->

<!-- Statistics Grid Section -->
<section class="mb-10">
    {% include_cached statistics.liquid %}
</section>
<!-- /Statistics Grid Section -->

<!-- Full Image Modal Popup -->
<div id="image-modal" class="fixed inset-0 z-50 bg-black/90 backdrop-blur-md hidden flex items-center justify-center p-4 md:p-10">
    <button id="close-modal-btn" class="absolute top-6 right-6 text-white bg-black border-2 border-white p-3 hover:bg-red-500 hover:border-red-500 transition-colors z-50">
        <svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" fill="none" class="w-6 h-6">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
    </button>
    <div class="relative max-w-5xl max-h-full flex items-center justify-center">
        <img id="modal-img" src="https://alsalafiyyah.github.io/assets/images/img.webp" alt="Full View" class="max-w-full max-h-[85vh] object-contain border-4 border-white">
    </div>
</div>
<!-- /Full Image Modal Popup -->

</main>

{{ footer_content }}
{% include scripts.html defer=true %}

</body>
</html>