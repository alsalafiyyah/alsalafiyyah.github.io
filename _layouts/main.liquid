---
layout: null
---
{% capture navbar %}
  {% include_cached navbar.liquid %}
{% endcapture %}
{% capture footer_content %}
  {% include_cached footer.liquid %}
{% endcapture %}

{% include head.liquid %}

<body dir="{{ site.site_elements.dir }}" itemscope itemtype="https://schema.org/WebPage" class="bg-white dark:bg-zinc-950 dark:text-zinc-100 text-black antialiased selection:bg-black selection:text-white dark:selection:bg-white dark:selection:text-black transition-colors duration-300 is-preload">

{{ navbar }}

<main role="main" class="max-w-7xl mx-auto px-8">

<!-- Top Section: Hero Block -->
<section class="mb-16 pb-12 border-b-2 border-black/10 dark:border-white/10 mt-10">
    {% include_cached hero.liquid %}
</section>
<!-- /Top Section: Hero Block -->

<!-- Main 3-Column Grid Container -->
<section class="mb-6 pb-12 mt-12 w-full max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start"><!-- Begin of 3-Column Grid Container -->

        <!-- Column 1 -->
        <div class="col-span-1 flex flex-col space-y-6">
            <div class="border-2 border-black dark:border-white overflow-hidden transition-colors duration-300">
                <!-- Vertical Image Preview with Modal Trigger -->
                <div class="relative group cursor-pointer w-full bg-gray-50 dark:bg-zinc-900 border-b-2 border-black dark:border-white" id="open-modal-btn">
                    <img src="{{ site.img_url }}/img.jpg?v={{ site.time | date: '%s' }}" alt="Circulated Image of Imam Muhammad bin Abd al-Wahhab" class="w-full h-auto block object-cover">
                    <!-- Zoom Hint Overlay -->
                    <div class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center text-white text-xs uppercase font-black tracking-widest pointer-events-none">
                        Click to View Full Image
                    </div>
                </div> 
                <!-- / Vertical Image Preview with Modal Trigger -->

                <!-- Vertical Card Content -->
                <div class="flex flex-col space-y-2 p-6">
                    <div class="flex items-center gap-1 text-[10px] font-black uppercase tracking-widest text-zinc-600 dark:text-zinc-400">
                        <span>1448-03-07 / 2026-08-20</span>
                    </div>
                    <h3 class="text-2xl font-black uppercase tracking-tighter leading-[0.95] serif">
                        The Truth Behind the Circulated Image of Imam Muhammad bin Abd al-Wahhab
                    </h3>             
                    <!-- Collapsible Text Container -->
                    <div class="relative">
                        <!-- Short Initial Preview Text -->
                        <div id="text-preview" class="space-y-3">
                            <p class="text-xs font-normal leading-relaxed text-zinc-600 dark:text-zinc-400">
                                The text in the provided image translates as follows:
                            </p>
                            <p class="text-xs font-normal leading-relaxed text-zinc-600 dark:text-zinc-400">
                                <strong>On the right side (False Claim):</strong> An alleged picture of the renewer Imam Muhammad ibn Abd al-Wahhab...
                            </p>
                       </div>
                        <!-- /Short Initial Preview Text -->
                        <!-- Full Text -->
                        <div id="text-full" class="hidden space-y-3 mt-2">
                            <p class="text-sm font-medium leading-relaxed text-zinc-600 dark:text-zinc-400">
                                The text in the provided image translates as follows:
                            </p>
                            <p class="text-xs font-normal leading-relaxed text-zinc-600 dark:text-zinc-400">
                                <strong>On the right side (False Claim):</strong> An alleged picture of the renewer Imam Muhammad ibn Abd al-Wahhab, may Allah have mercy on him, is being circulated across social media platforms. The image shows a person sitting on a chair, who they claim is Imam Muhammad ibn Saud, may Allah have mercy on him, and another standing beside him, who they claim is Imam Muhammad ibn Abd al-Wahhab, may Allah have mercy on him.
                            </p>
                            <p class="text-xs font-normal leading-relaxed text-zinc-600 dark:text-zinc-400">
                                <strong>On the left side (The Truth):</strong> This information is incorrect. The person sitting on the chair is Sheikh Abdullah bin Isa bin Ali Al Khalifa, a son of the ruler of Bahrain, and not Imam Muhammad ibn Saud... It is worth noting that the first photograph was taken in 1826, and the invention of photography was announced on August 19, 1839.
                            </p>
                            <p class="text-xs font-normal leading-relaxed text-zinc-600 dark:text-zinc-400">
                                Source: <a href="https://mujaddid.net/%d8%b5%d9%88%d8%b1%d8%a9-%d8%a7%d9%84%d8%a5%d9%85%d8%a7%d9%85-%d8%a7%d9%84%d9%85%d8%ac%d8%af%d8%af-%d9%85%d8%ad%d9%85%d8%af%d8%a8%d9%86-%d8%b9%d8%a8%d8%af%d8%a7%d9%84%d9%88%d9%87%d8%a7%d8%a8-%d8%a7/" target="_blank" class="underline font-bold hover:text-red-500">صورة الإمام محمد بن عبدالوهاب الفوتوغرافية بين الكذب والحقيقة؟!</a>
                            </p>
                        </div> 
                        <!-- /Full Text -->
                    </div> 
                    <!-- /Collapsible Text Container -->
                    <!-- Show More / Show Less Button -->
                    <div class="pt-2">
                        <button id="toggle-text-btn" class="text-xs font-black uppercase tracking-widest text-black dark:text-white border-b-2 border-black dark:border-white pb-1 hover:text-red-500 hover:border-red-500 transition-colors">
                            Show More ↓
                        </button>
                    </div> <!-- /Show More / Show Less Button -->
                </div>
            </div>
        </div>

        <!-- Column 2: Muqolat -->
        <div class="col-span-1 flex flex-col space-y-6 hidden md:block">
            {% assign featured_muqolat_post = site.posts | where: "featured_muqolat", true | first %}
            <div class="relative bg-cover bg-no-repeat bg-center flex flex-col justify-end min-h-[450px] overflow-hidden" style="background-image:url('{{ featured_muqolat_post.img | relative_url }}?v={{ site.time | date: '%s' }}')">
                <!-- Top Badge -->
                <span class="text-xs font-sans font-bold text-white absolute left-6 top-6 pb-2.5 border-b-2 border-red-500 z-10">
                    Muqolat
                </span>
                <!-- /Top Badge -->
                {% if featured_muqolat_post %}
                    <!-- Gradient Overlay & Content -->
                    <div class="flex flex-col items-start justify-end text-left pt-32 px-8 pb-8 bg-gradient-to-t from-black/90 via-black/40 to-transparent w-full">
                        <h3 class="flex items-center font-sans font-bold text-xs text-white mb-3">
                            <span class="w-2 h-2 rounded-full bg-red-500 flex-shrink-0 mr-2.5"></span>
                            {{ featured_muqolat_post.hijri }} / {{ featured_muqolat_post.date | date: "%Y-%m-%d" }}
                        </h3>
                        <a href="{{ featured_muqolat_post.url | relative_url }}" class="text-white text-2xl font-bold hover:underline leading-snug">
                            {{ featured_muqolat_post.title }}
                        </a>
                    </div>
                {% endif %}
            </div>

            <!-- Bottom Part: Standard Muqolat List & Button -->
            <div class="flex flex-col space-y-4 pt-2">
                {% assign muqolat = site.posts | where_exp: "post", "post.active == 'muqolat'" %}
                {% for post in muqolat limit:2 %}
                    {% if post.url != featured_muqolat_post.url %}
                        <div class="py-1">
                            <span class="text-[10px] font-bold text-zinc-600 dark:text-zinc-400 block mb-1">{{ post.hijri }} \ {{ post.date | date: "%Y-%m-%d" }}</span>
                            <a href="{{ post.url | relative_url }}" class="text-lg font-bold group-hover:underline block hover:underline">
                                {{ post.title }}
                            </a>
                        </div>
                    {% endif %}
                {% endfor %}

                <div class="flex flex-col w-full">
                    <div class="w-full flex h-0.5 bg-yellow-700/10 dark:bg-white/10">
                        <div class="w-1/2 bg-red-500 h-full"></div>
                    </div>
                    <a href="{{ '/muqolat' | relative_url }}" class="font-sans text-xs uppercase font-bold pt-5 flex w-full">View All Muqolat
                        <svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 ml-auto text-red-500">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </a>
                </div>
            </div>
        </div>

        <!-- Column 3: Recent Content -->
        <div class="col-span-1 flex flex-col justify-between h-full space-y-6 lg:border-l-2 border-t-2 lg:border-t-0 border-black/10 dark:border-white/10 lg:pl-6 pt-8 lg:pt-0" id="fatwa-recent-container">
            <div>
                <!-- Section Header -->
                <div class="flex items-center gap-4 mb-6 border-b-2 border-red-500 space-x-6 dark:border-white/10 pb-3 text-xs font-black uppercase tracking-wider">
                    <span class="text-black dark:text-white pb-1 whitespace-nowrap">
                        Recent Fatwas
                    </span>
                </div>
                <!-- /Section Header -->

                <!-- Recent Fatwas Content -->
                <div class="space-y-6">
                    <div class="space-y-6 py-3 flex flex-col">
                        {% for post in site.posts limit:5 %}
                        {% if post.url == featured_post.url %}{% continue %}{% endif %}
                        <a href="{{ post.url | relative_url }}" class="flex items-start gap-3 group" title="{{ post.title }}">
                            <span class="w-2 h-2 rounded-full bg-red-500 flex-shrink-0 mr-2.5 mt-2"></span>
                            <div class="flex flex-col">
                                <span class="text-[10px] font-bold text-zinc-600 dark:text-zinc-400 block mb-1">
                                    {{ post.hijri }} \ {{ post.date | date: "%Y-%m-%d" }}
                                </span>
                                <span class="text-base font-bold group-hover:underline">{{ post.title }}</span>
                            </div>
                        </a>
                        {% endfor %}
                    </div>
                    <div class="flex flex-col w-full pt-6">
                        <div class="w-full flex h-0.5 bg-yellow-700 bg-opacity-10"><div class="w-1/2 bg-red-500 h-full"></div></div>
                        <a href="/fatwas/" class="font-sans text-xs uppercase font-bold pt-5 flex w-full">View All Fatwas
                            <svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 ml-auto text-red-500"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                        </a>
                    </div>
                </div>
                <!-- /Recent Fatwas Content -->
            </div>
        </div>

    </div><!-- /End of 3-Column Grid Container -->
</section>
<!-- /Main 3-Column Grid Container -->

<!-- Statistics Grid Section -->
<section class="mb-10 hidden md:block">
    {% include_cached statistics.liquid %}
</section>
<!-- /Statistics Grid Section -->

<!-- Full Image Modal Popup -->
<div id="image-modal" class="fixed inset-0 z-50 bg-black/90 backdrop-blur-md hidden flex items-center justify-center p-4 md:p-10">
    <button id="close-modal-btn" class="absolute top-6 right-6 text-white bg-black border-2 border-white p-3 hover:bg-red-500 hover:border-red-500 transition-colors z-50">
        <svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" fill="none" class="w-6 h-6">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
    </button>
    <div class="relative max-w-5xl max-h-full flex items-center justify-center">
        <img id="modal-img" src="{{ site.img_url }}/img.jpg?v={{ site.time | date: '%s' }}" alt="Full View" class="max-w-full max-h-[85vh] object-contain border-4 border-white">
    </div>
</div>
<!-- /Full Image Modal Popup -->

</main>

{{ footer_content }}
{% include scripts.html defer=true %}

</body>
</html>