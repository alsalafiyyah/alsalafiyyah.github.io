---
layout: null
---
{% capture navbar %}
  {% include_cached navbar.liquid %}
{% endcapture %}
{% capture footer_content %}
  {% include_cached footer.liquid %}
{% endcapture %}
<!DOCTYPE html>
<html lang="{{ site.site_elements.lang }}" dir="{{ site.site_elements.dir }}">
<head>
{% include head.liquid %}
</head>
<body dir="{{ site.site_elements.dir }}" itemscope itemtype="https://schema.org/WebPage" class="bg-white dark:bg-zinc-950 dark:text-zinc-100 text-black antialiased selection:bg-black selection:text-white dark:selection:bg-white dark:selection:text-black transition-colors duration-300 is-preload">
{{ navbar }}
<main role="main" class="max-w-7xl mx-auto px-8">
<!-- Top Section: Hero Block -->
<section class="mb-16 pb-12 border-b-2 border-black/10 dark:border-white/10 mt-10">
    <div class="flex flex-col space-y-8">
        <div class="flex items-center gap-4 text-[10px] font-black uppercase tracking-[0.3em] text-gray-400 italic">
            <span class="w-2 h-2 rounded-full bg-red-500 flex-shrink-0 mr-2.5"></span>
            <span class="text-black dark:text-white">Selected Fatwa</span>
        </div>
        {% assign featured_post = site.posts | where: "featured", true | first %}
        {% if featured_post %}
        <h2 class="text-6xl md:text-[5vw] lg:text-[4.5vw] font-black uppercase tracking-tighter leading-[0.85] serif">
            <a href="{{ featured_post.url | relative_url }}" class="hover:line-through transition-all">
               {{ featured_post.title }}
            </a>
        </h2>
        <div class="flex items-center gap-6 text-[10px] font-black uppercase tracking-widest opacity-50">
            <span>{{ featured_post.hijri }} / {{ featured_post.date | date: "%d.%m.%Y" }}</span>
        </div>
        <p class="text-xl md:text-3xl font-bold leading-relaxed opacity-85 max-w-5xl">
         {{ featured_post.summary | strip_html }}
        </p>
        <div>
            <a href="{{ featured_post.url | relative_url }}" class="inline-block bg-black text-white dark:bg-white dark:text-black px-12 py-5 font-black uppercase tracking-widest text-xs hover:scale-105 transition-transform">
                Read Full Fatwa →
            </a>
        </div>
       {% endif %}
    </div>
</section>

<section class="mb-6 pb-12 mt-12">
    <!-- Main 3-Column Grid Container -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 items-start">
        <div class="col-span-1 flex flex-col space-y-6 lg:col-span-1">
           {% include_cached homepage_col1.liquid %}
         </div>
     </div>

     <!-- Column 2 Muqolat -->
    <div class="col-span-1 flex flex-col space-y-6 lg:col-span-1">
     {% include_cached homepage_col2.liquid %}
    </div>

        <!-- Column 3: Tabbed Content (Recent, Audio, Video Fatwas) -->
        <div class="flex flex-col justify-between h-full space-y-6 lg:col-span-1 border-t-2 lg:border-t-0 lg:border-l-2 border-black/10 dark:border-white/10 lg:pl-12 pt-8 lg:pt-0" id="fatwa-tabs-container">
          {% include_cached homepage_col3.liquid %}
        </div>
</section>

<!-- Additional Bottom Section: Featured Editorial Block with Image & Long Text -->
<section class="mb-24 mt-16 hidden">
    <div class="border-2 border-black dark:border-white bg-white dark:bg-black p-0 md:p-0 transition-colors duration-300">

        <!-- Grid Layout for Image + Content -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-0 items-center">
            
            <!-- Image Column (5 Cols) with Full Width & Clickable Preview -->
            <div class="lg:col-span-5 relative group cursor-pointer h-full" id="open-modal-btn">
                <div class="bg-gray-50 dark:bg-zinc-900 h-full flex items-center">
                    <img src="https://alsalafiyyah.github.io/assets/images/img.webp" alt="Circulated Image of Imam Muhammad bin Abd al-Wahhab" class="w-full h-auto block object-cover">
                </div>
                <!-- Zoom Hint Overlay -->
                <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center text-white text-xs uppercase font-black tracking-widest pointer-events-none">
                    Click to View Full Image
                </div>
            </div>

            <!-- Content Column (7 Cols) -->
            <div class="lg:col-span-7 flex flex-col justify-between space-y-4 p-6 md:p-8">
                <div>
                    <div class="flex items-center gap-6 text-[10px] font-black uppercase tracking-widest opacity-50 mb-4">
                        <span>1448-03-07 / 20.08.2026</span>
                    </div>
                    <h3 class="text-3xl md:text-3xl lg:text-3xl font-black uppercase tracking-tighter leading-[0.9] serif mb-6">
                        The Truth Behind the Circulated Image of Imam Muhammad bin Abd al-Wahhab
                    </h3>
                    
                    <!-- Collapsible Text Container -->
                    <div class="relative">
                        <!-- Short Initial Preview Text -->
                        <div id="text-preview" class="space-y-4">
                            <p class="text-base md:text-lg font-medium leading-relaxed opacity-80">
                                The text in the provided image translates as follows:
                            </p>
                            <p class="text-sm md:text-base font-normal leading-relaxed opacity-60">
                                <strong>On the right side (False Claim):</strong> An alleged picture of the renewer Imam Muhammad ibn Abd al-Wahhab, may Allah have mercy on him, is being circulated across social media platforms. The image shows a person sitting on a chair, who they claim is Imam Muhammad ibn Saud, may Allah have mercy on him, and another standing beside him, who they claim is Imam Muhammad ibn Abd al-Wahhab, may Allah have mercy on him.
                            </p>
                        </div>

                        <!-- Full Text (Initially Hidden) -->
                        <div id="text-full" class="hidden space-y-4 mt-4">
                            <p class="text-base md:text-lg font-medium leading-relaxed opacity-80">
                                The text in the provided image translates as follows:
                            </p>
                            <p class="text-sm md:text-base font-normal leading-relaxed opacity-60">
                                <strong>On the right side (False Claim):</strong> An alleged picture of the renewer Imam Muhammad ibn Abd al-Wahhab, may Allah have mercy on him, is being circulated across social media platforms. The image shows a person sitting on a chair, who they claim is Imam Muhammad ibn Saud, may Allah have mercy on him, and another standing beside him, who they claim is Imam Muhammad ibn Abd al-Wahhab, may Allah have mercy on him.
                            </p>
                            <p class="text-sm md:text-base font-normal leading-relaxed opacity-60">
                                <strong>On the left side (The Truth):</strong> This information is incorrect. The person sitting on the chair is Sheikh Abdullah bin Isa bin Ali Al Khalifa, a son of the ruler of Bahrain, and not Imam Muhammad ibn Saud, the founder of the First Saudi State who passed away in 1765. The other person standing next to him is Sheikh Muhammad bin Abd al-Wahhab al-Faihani [al-Subai’i], may Allah have mercy on him, the Bahraini pearl merchant who was born in Bahrain in 1863 and died in Bombay, India, in 1906, and not the reformer Imam Muhammad ibn Abd al-Wahhab, who passed away in 1791. It is worth noting that the first photograph was taken in 1826, and the invention of photography was announced on August 19, 1839.
                            </p>
                            <p class="text-sm md:text-base font-normal leading-relaxed opacity-60">
                                Source: <a href="https://mujaddid.net/%d8%b5%d9%88%d8%b1%d8%a9-%d8%a7%d9%84%d8%a5%d9%85%d8%a7%d9%85-%d8%a7%d9%84%d9%85%d8%ac%d8%af%d8%af-%d9%85%d8%ad%d9%85%d8%af%d8%a8%d9%86-%d8%b9%d8%a8%d8%af%d8%a7%d9%84%d9%88%d9%87%d8%a7%d8%a8-%d8%a7/" target="_blank" class="underline font-bold hover:text-red-500">صورة الإمام محمد بن عبدالوهاب الفوتوغرافية بين الكذب والحقيقة؟!</a>
                            </p>
                        </div>
                    </div>

                    <!-- Show More / Show Less Button -->
                    <div class="mt-6">
                        <button id="toggle-text-btn" class="text-xs font-black uppercase tracking-widest text-black dark:text-white border-b-2 border-black dark:border-white pb-1 hover:text-red-500 hover:border-red-500 transition-colors">
                            Show More ↓
                        </button>
                    </div>

                </div>
            </div>

        </div>
    </div>
</section>

<!-- Statistics Grid Section -->
<section class="mb-10">
    <div class="bg-white dark:bg-black transition-colors duration-300">
        <!-- Section Header -->
        <div class="flex items-center gap-4 mb-8 text-[10px] font-black uppercase tracking-[0.3em] text-gray-400 italic border-b-2 border-black/10 dark:border-white/10 pb-4">
            <span class="w-2 h-2 rounded-full bg-red-500 flex-shrink-0 mr-2.5"></span>
            <span class="text-black dark:text-white">Statistics</span>
        </div>
        <!-- Stats Grid -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
            <!-- Stat Item 1: Fatwas -->
            <div class="flex flex-col space-y-1 border-l-2 border-red-500 pl-4">
                <span class="text-3xl md:text-4xl font-black tracking-tighter serif">{{ site.posts.size }}</span>
                <span class="text-[10px] font-black uppercase tracking-widest opacity-60">Published Fatwas</span>
            </div>
            <!-- Stat Item 2: Audios -->
            <div class="flex flex-col space-y-1 border-l-2 border-red-500 pl-4">
                {% assign audio_posts = site.posts | where_exp: "post", "post.active == 'audios'" %}
                <span class="text-3xl md:text-4xl font-black tracking-tighter serif">{{ audio_posts.size }}</span>
                <span class="text-[10px] font-black uppercase tracking-widest opacity-60">Audio Fatwas & Lectures</span>
            </div>
            <!-- Stat Item 3: Videos -->
            <div class="flex flex-col space-y-1 border-l-2 border-red-500 pl-4">
                {% assign video = site.posts | where_exp: "post", "post.active == 'videos'" %}
                <span class="text-3xl md:text-4xl font-black tracking-tighter serif">{{ video.size }}</span>
                <span class="text-[10px] font-black uppercase tracking-widest opacity-60">Video Clips</span>
            </div>
            <!-- Stat Item 4: Muqolat -->
            <div class="flex flex-col space-y-1 border-l-2 border-red-500 pl-4">
                {% assign muqolat = site.posts | where_exp: "post", "post.active == 'muqolat'" %}
                <span class="text-3xl md:text-4xl font-black tracking-tighter serif">{{ muqolat.size }}</span>
                <span class="text-[10px] font-black uppercase tracking-widest opacity-60">Muqolat/Articles</span>
            </div>
        </div>
    </div>
</section>

<!-- Full Image Modal Popup -->
<div id="image-modal" class="fixed inset-0 z-50 bg-black/90 backdrop-blur-md hidden flex items-center justify-center p-4 md:p-10">
    <button id="close-modal-btn" class="absolute top-6 right-6 text-white bg-black border-2 border-white p-3 hover:bg-red-500 hover:border-red-500 transition-colors z-50">
        <svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" fill="none" class="w-6 h-6">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
    </button>
    <div class="relative max-w-5xl max-h-full flex items-center justify-center">
        <img id="modal-img" src="https://alsalafiyyah.github.io/assets/images/img.webp" alt="Full View" class="max-w-full max-h-[85vh] object-contain border-4 border-white">
    </div>
</div>
</main>
{{ footer_content }}
{% include scripts.html defer=true %}
</body>
</html>